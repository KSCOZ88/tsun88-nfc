{
  "functions": {
    "api/order-email.js": {
      "maxDuration": 60,
      "includeFiles": "{server/print-assets/address-vintage.jpg,node_modules/@fontsource/pinyon-script/files/pinyon-script-latin-400-normal.woff,node_modules/@embedpdf/fonts-tc/fonts/NotoSansHant-Regular.otf}"
    },
    "api/airwallex-create-session.js": {
      "maxDuration": 30
    },
    "api/airwallex-fps.js": {
      "maxDuration": 60
    },
    "api/airwallex-confirm-session.js": {
      "maxDuration": 60,
      "includeFiles": "{server/print-assets/address-vintage.jpg,node_modules/@fontsource/pinyon-script/files/pinyon-script-latin-400-normal.woff,node_modules/@embedpdf/fonts-tc/fonts/NotoSansHant-Regular.otf}"
    },
    "api/airwallex-paid-order-email.js": {
      "maxDuration": 60,
      "includeFiles": "{server/print-assets/address-vintage.jpg,node_modules/@fontsource/pinyon-script/files/pinyon-script-latin-400-normal.woff,node_modules/@embedpdf/fonts-tc/fonts/NotoSansHant-Regular.otf}"
    },
    "api/airwallex-webhook.mjs": {
      "maxDuration": 60
    },
    "api/stripe-webhook.js": {
      "maxDuration": 60,
      "includeFiles": "{server/print-assets/address-vintage.jpg,node_modules/@fontsource/pinyon-script/files/pinyon-script-latin-400-normal.woff,node_modules/@embedpdf/fonts-tc/fonts/NotoSansHant-Regular.otf}"
    },
    "api/create-checkout-session.js": {
      "maxDuration": 30
    },
    "api/confirm-paid-order.js": {
      "maxDuration": 60
    },
    "api/paypal-paid-order-email.js": {
      "includeFiles": "{server/print-assets/address-vintage.jpg,node_modules/@fontsource/pinyon-script/files/pinyon-script-latin-400-normal.woff,node_modules/@embedpdf/fonts-tc/fonts/NotoSansHant-Regular.otf}"
    },
    "api/paid-order-email.js": {
      "maxDuration": 60,
      "includeFiles": "{server/print-assets/address-vintage.jpg,node_modules/@fontsource/pinyon-script/files/pinyon-script-latin-400-normal.woff,node_modules/@embedpdf/fonts-tc/fonts/NotoSansHant-Regular.otf}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/p/:profile",
      "destination": "/lucky88.html"
    },
    {
      "source": "/merchant",
      "destination": "/index.html"
    },
    {
      "source": "/merchant-profile",
      "destination": "/lucky88.html"
    },
    {
      "source": "/merchant/orders",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/lucky88.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/p/:profile",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/merchant",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "connect-src 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/merchant-profile",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "connect-src 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/merchant/orders",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "connect-src 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/airwallex-webhook",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/stripe-webhook",
      "schedule": "15 0 * * *"
    }
  ]
}
