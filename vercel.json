{
  "functions": {
    "api/order-email.js": {
      "maxDuration": 60
    },
    "api/airwallex-create-session.js": {
      "maxDuration": 30
    },
    "api/airwallex-confirm-session.js": {
      "maxDuration": 30
    },
    "api/airwallex-paid-order-email.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/lucky88.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
