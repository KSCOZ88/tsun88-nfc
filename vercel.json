{
  "functions": {
    "api/order-email.js": {
      "maxDuration": 60
    },
    "api/airwallex-create-session.js": {
      "maxDuration": 30
    },
    "api/airwallex-confirm-session.js": {
      "maxDuration": 60
    },
    "api/airwallex-paid-order-email.js": {
      "maxDuration": 60
    },
    "api/airwallex-webhook.mjs": {
      "maxDuration": 60
    },
    "api/stripe-webhook.js": {
      "maxDuration": 60
    },
    "api/create-checkout-session.js": {
      "maxDuration": 30
    },
    "api/confirm-paid-order.js": {
      "maxDuration": 60
    },
    "api/paid-order-email.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/lucky88.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/airwallex-webhook",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/stripe-webhook",
      "schedule": "15 0 * * *"
    }
  ]
}
